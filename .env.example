# mock | anthropic | vertex
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
VERTEX_PROJECT=
VERTEX_REGION=us-east5

DATABASE_URL=sqlite:///:memory:
# set to pgvector to keep runbook embeddings in PostgreSQL
VECTOR_STORE=
RESET_DB=true

# memory | kafka | pubsub
EVENT_BUS=memory
KAFKA_BOOTSTRAP=localhost:9092
ALARM_TOPIC=noc.alarms

# inproc, or the URL of a running MCP server, e.g. http://mcp-server:8001/mcp
MCP_SERVER=inproc

# none | low | medium | high : actions at or below this risk run without a human
AUTO_APPROVE_MAX_RISK=none
